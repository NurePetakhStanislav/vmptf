<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="bottom">

    <!-- Поле введення виразу (великий текст) -->
    <EditText
        android:id="@+id/etExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0"
        android:textSize="36sp"
        android:gravity="end"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:inputType="text"
        android:maxLines="2" />

    <!-- Автоматичний результат на льоту -->
    <TextView
        android:id="@+id/tvLiveResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="= 0"
        android:textSize="24sp"
        android:textColor="#757575"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:layout_marginBottom="24dp" />

    <!-- РЯД 1: ^ , % , C (Очищення) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/bPower" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="^" android:textSize="20sp"/>
        <Button android:id="@+id/bMod" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="%" android:textSize="20sp"/>
        <Button android:id="@+id/bClear" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:backgroundTint="#F44336" android:text="C" android:textSize="20sp"/>
    </LinearLayout>

    <!-- РЯД 2: 7 , 8 , 9 , / -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/b7" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="7" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/b8" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="8" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/b9" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="9" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/bDivide" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="/" android:textSize="20sp"/>
    </LinearLayout>

    <!-- РЯД 3: 4 , 5 , 6 , * -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/b4" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="4" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/b5" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="5" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/b6" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="6" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/bMultiply" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="*" android:textSize="20sp"/>
    </LinearLayout>

    <!-- РЯД 4: 1 , 2 , 3 , - -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/b1" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="1" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/b2" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="2" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/b3" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="3" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/bMinus" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="-" android:textSize="20sp"/>
    </LinearLayout>

    <!-- РЯД 5: 0 , . (крапка) , + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button android:id="@+id/b0" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="2" android:text="0" android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/bDot" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="." android:textSize="20sp" android:backgroundTint="#424242"/>
        <Button android:id="@+id/bPlus" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="+" android:textSize="20sp"/>
    </LinearLayout>

    <!-- Кнопки дій з файлом -->
    <Button
        android:id="@+id/bSaveToFile"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#4CAF50"
        android:text="Зберегти в історію"
        android:textSize="18sp" />

    <Button
        android:id="@+id/bShowHistory"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#607D8B"
        android:text="Показати історію з файлу"
        android:textSize="16sp" />

</LinearLayout>